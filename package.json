	"description": "Freeze variations and features in font.",
	"keywords": [
		"font",
		"opentype",
		"opentype-features",
		"variable-fonts",
		"ligatures",
		"stylistic-sets",
		"font-instancer",
		"webassembly"
	],
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MuTsunTsai/fontfreeze.git"
	},
	"license": "MIT",
	"author": "Mu-Tsun Tsai <don.m.t.tsai@gmail.com> (https://github.com/MuTsunTsai)",
	"type": "module",
	"scripts": {
		"prebuild": "gulp release",
		"build": "rsbuild build",
		"predev": "gulp",
		"dev": "rsbuild dev",
		"e2e": "playwright test",
		"preview": "rsbuild preview --port 3091 --open http://localhost:3091/fontfreeze/",
		"test": "rstest",
		"typecheck": "tsc -p . && vue-tsc -p src/app && vue-tsc -p test/unit && vue-tsc -p test/e2e"
	},
	"dependencies": {
		"probably-china": "^1.1.0",
