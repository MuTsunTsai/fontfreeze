{
	"cSpell.ignoreRegExpList": [
		"/([\"'`])[a-z]{4}\\1/gi"
	],
	"cSpell.words": [
		"binaryen",
		"cmap",
		"fontfaces",
		"fontfreeze",
		"fontoxide",
		"fonttools",
		"fvar",
		"glyf",
		"gsub",
		"gvar",
		"hhea",
		"hmtx",
		"onloadingdone",
		"rsbuild",
		"unicodes",
		"vfit",
		"vuetify",
		"Webfont"
	],
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"*.css": "$(capture).css.map",
		"*.js": "$(capture).prod.js, $(capture).min.js, $(capture).js.map",
		".gitignore": ".gitattributes",
		"Cargo.toml": "Cargo.lock",
		"README.md": "LICENSE.md, CONTRIBUTING.md, README.*.md",
		"eslint.config.js": ".editorconfig",
		"package.json": "pnpm-*.yaml, .npmrc, .browserslistrc"
	},
	"files.exclude": {
		".ruff_cache/": true,
		"node_modules/": true,
		"patches/": true
	},
	"i18n-ally.localesPaths": [
		"src/locale"
	],
	"rust-analyzer.linkedProjects": [
		"src\\rust\\Cargo.toml"
	]
}